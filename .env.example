# Root-level .env — only for variables interpolated by docker-compose.yml
# (the ${VAR:-default} substitutions). Per-app runtime config still lives in
# apps/<app>/.env. Copy to .env in the same directory and uncomment / change
# the values you want to override; everything has a working default so the
# stack boots green even with this file empty.

# ─── Auth & secrets ──────────────────────────────────────────────────────
# AUTH_PROVIDER=local                    # local | auth0
# JWT_SECRET=change-me-openssl-rand-hex-32
# JWT_ACCESS_TTL=3600                    # seconds
# JWT_REFRESH_TTL=2592000                # seconds (30d)
# JWT_AUDIENCE=bms-msgops-api
# CRON_SECRET=change-me-openssl-rand-hex-32
# INTERNAL_AUTH_TOKEN=change-me

# ─── URLs / CORS ─────────────────────────────────────────────────────────
# FRONTEND_URL=http://localhost:8080
# CORS_ORIGINS=http://localhost:8080

# ─── RabbitMQ ────────────────────────────────────────────────────────────
# RABBITMQ_DEFAULT_USER=guest
# RABBITMQ_DEFAULT_PASS=guest

# ─── SendGrid ────────────────────────────────────────────────────────────
# Default points at the in-stack mock; override to hit a real account.
# SENDGRID_API_BASE_URL=https://api.sendgrid.com
# SENDGRID_API_KEY=SG.xxxxx
# SENDGRID_WEBHOOK_URL_BASE=http://event-receiver:3011/bms/events?platform=sendgrid
# SENDGRID_KEYS_MAP={"campaign-key":"SG.xxx", ...}
# SPARKPOST_API_KEY=

# ─── SendGrid mock simulation knobs ──────────────────────────────────────
# Probabilities [0,1]. Defaults reproduce a 100% delivered/open/click happy
# path. Tune to simulate realistic mixes during demos / load tests.
# SENDGRID_MOCK_EVENT_DELAY_MS=500       # delay between event ticks (ms)
# SENDGRID_MOCK_DROPPED_RATE=0.02        # 2% suppressed pre-delivery
# SENDGRID_MOCK_BOUNCE_RATE=0.05         # 5% hard-bounce
# SENDGRID_MOCK_DEFERRED_RATE=0.01       # 1% temporary delivery failure
# SENDGRID_MOCK_OPEN_RATE=0.4            # 40% open rate
# SENDGRID_MOCK_CLICK_RATE=0.1           # 10% of opens click
# SENDGRID_MOCK_SPAM_RATE=0.005          # 0.5% spam_report
# SENDGRID_MOCK_UNSUBSCRIBE_RATE=0.01    # 1% unsubscribe

# ─── WhatsApp Cloud (Meta direct + EvoHub) ──────────────────────────────
# Substitui a integração Evolution API. Credenciais reais (APP_ID/SECRET,
# HUB_API_KEY etc.) são configuradas via Super Admin → Integrações →
# WhatsApp depois do boot; o backend lê de system_config primeiro e cai pra
# env só como fallback. Guia: docs/operations/whatsapp-cloud.md.
# WHATSAPP_PROVIDER=cloud                 # cloud | twilio (legacy)
# WHATSAPP_GRAPH_VERSION=v18.0
# WHATSAPP_APP_ID=
# WHATSAPP_APP_SECRET=
# WHATSAPP_CONFIG_ID=
# WHATSAPP_VERIFY_TOKEN=
# EVOLUTION_HUB_ENABLED=false             # true → modo proxy via api.evohub.ai
# EVOLUTION_HUB_URL=https://api.evohub.ai
# EVOLUTION_HUB_API_KEY=
# EVOLUTION_HUB_WEBHOOK_SECRET=
# BMS_PUBLIC_URL=                          # default = FRONTEND_URL. Em dev, use o domínio do ngrok.

# ─── Misc ────────────────────────────────────────────────────────────────
# LIMIT_CONTACT_BATCH=1000               # campaign-packer batch size
# OPEN_AI_KEY=
# GEO_REFRESH_SKIP_VALIDATION=0          # 1 to skip GeoIP validation step

# ─── ETUS Open Telemetry ─────────────────────────────────────────────────
# Anonymous instance telemetry (LGPD-compliant). See docs/telemetry.md.
# Set ETUS_TELEMETRY_ENABLED=false to disable. DO_NOT_TRACK=1 also disables (universal flag, takes precedence).
# ETUS_TELEMETRY_ENABLED=true
# ETUS_TELEMETRY_ENDPOINT=https://telemetry.etus.com.br
