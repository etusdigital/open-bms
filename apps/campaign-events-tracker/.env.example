PORT=3004

SERVICE_ACCOUNT=

TYPEORM_HOST=127.0.0.1
TYPEORM_PORT=5432
TYPEORM_USERNAME=postgres
TYPEORM_PASSWORD=
TYPEORM_DATABASE=msgops_prd
TYPEORM_DRIVER_EXTRA={"charset":"utf8mb4_unicode_ci"}
TYPEORM_LOGGING=true
TYPEORM_DROP_SCHEMA=false
TYPEORM_MIGRATIONS_RUN=true
TYPEORM_MIGRATIONS_TABLE_NAME=migration

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

GOOGLE_TASKS_PROJECT_ID=<your-gcp-project-id>
GOOGLE_TASKS_LOCATION=us-east1
GOOGLE_TASK_QUEUE=
CAMPAIGN_TRIGGER_ENDPOINT=
GOOGLE_CLIENT_EMAIL=<service-account-email@your-project.iam.gserviceaccount.com>
