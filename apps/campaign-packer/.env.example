PORT=3003

# GCP service account JSON, stringified. Required for Pub/Sub and Cloud Tasks.
SERVICE_ACCOUNT=

LIMIT_CONTACT_BATCH=1000
DEFAULT_WARMUP_MESSAGES=1,2

TOPIC_MSGOPS_CAMPAIGN_EVENTS_TRACKER=msgops.campaign.events.tracker
TOPIC_MSGOPS_CAMPAIGN_SEND_MESSAGE=msgops.campaign-packer.send-messages
TOPIC_MSGOPS_CAMPAIGN_SCHEDULE_PAGE=msgops.campaign-packer.schedule-pages
TOPIC_MSGOPS_WARMUP_TRACKER=
TOPIC_MSGOPS_CAMPAIGN_PACKER=
TOPIC_MSGOPS_CAMPAIGN_PACKER_WARMUP=

TYPEORM_HOST=127.0.0.1
TYPEORM_PORT=5432
TYPEORM_USERNAME=postgres
TYPEORM_PASSWORD=
TYPEORM_DATABASE=msgops_prd
TYPEORM_DRIVER_EXTRA={"charset":"utf8mb4_unicode_ci"}
TYPEORM_LOGGING=true

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Cloud Tasks (GCP)
GOOGLE_TASK_PROJECT=<your-gcp-project-id>
GOOGLE_TASK_QUEUE_NAME=msgops-campaign-packer
GOOGLE_TASK_QUEUE_CAMPAIGN_NAME=msgops-campaign-packer-campaign
GOOGLE_TASK_LOCATION=us-east1
GOOGLE_CLIENT_EMAIL=<service-account-email@your-project.iam.gserviceaccount.com>
GOOGLE_TASK_CALLBACK_URL=https://your-campaign-packer.example.com/process-page
GOOGLE_TASK_CAMPAIGN_URL=https://your-campaign-packer.example.com/start-campaign

# Tag process API base URL for segment resolution (Docker Compose default; local dev: http://localhost:3001/process-segment/)
TAG_PROCESS_API=http://tag-process:3000/process-segment/

# SendGrid stats API (env var name is SEDNGRID — matches existing code typo)
SEDNGRID_API_URL=https://api.sendgrid.com/v3

LOG_LEVEL=DEBUG
