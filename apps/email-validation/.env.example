PORT=3000

TYPEORM_HOST=127.0.0.1
TYPEORM_PORT=5432
TYPEORM_USERNAME=postgres
TYPEORM_PASSWORD=
TYPEORM_DATABASE=msgops
TYPEORM_DRIVER_EXTRA={"charset":"utf8mb4_unicode_ci"}
TYPEORM_MIGRATIONS_TABLE_NAME=migration
TYPEORM_MIGRATIONS_RUN=true

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Emailable credentials are configured via the BMS admin UI at /super-admin/integrations
# and loaded automatically from /data/config/emailable.env on startup. Do NOT set them here.

# Email validation provider: noop (no external check, always deliverable) | emailable (paid Emailable API)
EMAIL_VALIDATION_PROVIDER=noop

EMAILABLE_API_KEY=
EMAILABLE_URL=
