# Banco operacional (compartilhado com msgops-api)
TYPEORM_HOST=localhost
TYPEORM_PORT=5432
TYPEORM_USERNAME=
TYPEORM_PASSWORD=
TYPEORM_DATABASE=
TYPEORM_SSL=false

# Redis (BullMQ — mesma instância dos outros workers)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Chave de cifragem AES-256-GCM da apiKey Enterprise no payload do job.
# Gere com: openssl rand -base64 32
# DEVE ser igual ao do msgops-api (apenas msgops-api cifra; o worker decifra).
ENTERPRISE_IMPORT_ENCRYPTION_KEY=8FbzUAhcQsKnc3wOUWMnZ1r/5L13OGz27itXVNndXHI=

# Tamanhos de batch por entidade. Defaults seguros estão hard-coded no
# enterprise-client (contacts: 1000, messages: 500, statistics: 30 dias, demais: 500).
ENTERPRISE_IMPORT_BATCH_SIZE_CONTACTS=1000
ENTERPRISE_IMPORT_BATCH_SIZE_MESSAGES=500
ENTERPRISE_IMPORT_BATCH_SIZE_DEFAULT=500
