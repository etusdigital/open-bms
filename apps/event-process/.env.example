# DATABASE_* / DATABASE_LOGS_* take precedence; TYPEORM_* are accepted as
# fallback so this service can share env with the rest of the monorepo
# (docker-compose sets only TYPEORM_*).
DATABASE_HOST=127.0.0.1
DATABASE_PORT=5432
DATABASE_USERNAME=
DATABASE_PASSWORD=
DATABASE_DATABASE=msgops_api
DATABASE_MAX_CONECTIONS=40

DATABASE_LOGS_HOST=127.0.0.1
DATABASE_LOGS_PORT=5432
DATABASE_LOGS_USERNAME=
DATABASE_LOGS_PASSWORD=
DATABASE_LOGS_DATABASE=msgops_api

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

AMQP_URL=amqp://guest:guest@localhost:5672
INTERNAL_AUTH_TOKEN=dev-event-process-token-change-me-please
BRIDGE_ENDPOINT=http://localhost:3000

LOG_LEVEL=DEBUG

GEOIP_SERVICE_URL=
GEO_ENRICHMENT_ENABLED=true
GEO_PROVIDER=local
GEO_GRPC_URL=geolocation:50051
GEO_API_KEY=

# Lookups are cached in Redis when REDIS_HOST is set (default behavior).
# Set GEO_CACHE_ENABLED=false to disable. Override TTLs in seconds.
# GEO_CACHE_ENABLED=true
# GEO_CACHE_TTL_SECONDS=86400
# GEO_CACHE_NULL_TTL_SECONDS=3600

SLACK_WEBHOOK_URL=
