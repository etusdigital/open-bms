VITE_AUTH0_DOMAIN=brius-com-br.us.auth0.com
VITE_AUTH0_CLIENT_ID=<auth0-spa-client-id>
VITE_AUTH0_AUDIENCE=https://msgops-api.etus.digital
VITE_API_URL=http://localhost:5001
VITE_REDIRECT_MANAGER_URL=<manage-account-external-url>

# Sentry (error monitoring)
VITE_SENTRY_DSN=
VITE_SENTRY_ENABLED=          # Set to "true" to enable in non-production (e.g. staging)

# Microsoft Clarity (session recording / heatmaps)
VITE_CLARITY_PROJECT_ID=

# Sentry source map upload (CI only — do NOT prefix with VITE_)
# SENTRY_AUTH_TOKEN=
# SENTRY_ORG=
# SENTRY_PROJECT=

E2E_TEST_USER_EMAIL=e2e-test@etus.com.br
E2E_TEST_USER_PASSWORD=
