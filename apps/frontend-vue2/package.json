{
  "name": "msg-ops",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "serve": "vue-cli-service serve --port 44357",
    "build": "vue-cli-service build",
    "test:unit": "jest",
    "test:e2e": "vue-cli-service test:e2e",
    "lint": "vue-cli-service lint",
    "lint:fix": "eslint --cache --fix \"src/**/*.{js,ts,vue}\"",
    "pre-commit": "lint-staged",
    "prepare": "husky install || true",
    "build-watch": "vue-cli-service build --watch",
    "run-cypress": "cypress run",
    "test": "vue-cli-service test:unit",
    "test-cypress": "cypress open"
  },
  "dependencies": {
    "@gtm-support/vue2-gtm": "^1.3.0",
    "@rxweb/reactive-forms": "^1.0.0",
    "@sentry/tracing": "^6.16.1",
    "@sentry/vue": "^6.16.1",
    "apexcharts": "^3.48.0",
    "axios": "^0.21.1",
    "bootstrap": "^4.6.0",
    "core-js": "^3.49.0",
    "dayjs": "^1.11.7",
    "dompurify": "^3.1.6",
    "floating-vue": "^1.0.0-beta.19",
    "papaparse": "^5.4.1",
    "reflect-metadata": "^0.1.13",
    "tslib": "^2.8.1",
    "v-emoji-picker": "^2.3.3",
    "vue": "^2.6.12",
    "vue-apexcharts": "^1.6.2",
    "vue-class-component": "^7.2.6",
    "vue-cli-plugin-vuetify": "^2.1.0",
    "vue-email-editor": "^0.9.0",
    "vue-i18n": "^8.27.2",
    "vue-js-modal": "^1.3.34",
    "vue-json-compare": "^3.0.0",
    "vue-multiselect": "^2.1.6",
    "vue-property-decorator": "^8.5.1",
    "webpack": "4.47.0",
    "vue-router": "^3.5.1",
    "vue-typescript-inject": "^0.3.1",
    "vue2-filters": "^0.11.1",
    "vuetify": "^2.4.0",
    "vuex": "^3.6.2"
  },
  "devDependencies": {
    "@commitlint/cli": "^17.4.0",
    "@commitlint/config-conventional": "^17.4.0",
    "@types/dompurify": "^3.0.5",
    "@types/jest": "^26.0.20",
    "@types/node": "^18.11.18",
    "@types/papaparse": "^5.3.7",
    "@types/vue-json-compare": "^3.0.0",
    "@typescript-eslint/eslint-plugin": "^5.48.0",
    "@typescript-eslint/parser": "^5.48.0",
    "@vue/cli-plugin-babel": "^4.5.11",
    "@vue/cli-plugin-typescript": "^4.5.11",
    "@vue/cli-plugin-unit-jest": "^4.5.11",
    "@vue/cli-service": "^4.5.11",
    "@vue/runtime-dom": "^3.4.10",
    "@vue/test-utils": "^1.1.3",
    "cypress": "^6.4.0",
    "eslint": "^8.31.0",
    "eslint-config-prettier": "^8.6.0",
    "eslint-plugin-prettier": "^4.2.1",
    "eslint-plugin-sonarjs": "^0.5.0",
    "eslint-plugin-vue": "^9.8.0",
    "husky": "^8.0.3",
    "jest": "^26.6.3",
    "jest-sonar-reporter": "^2.0.0",
    "lint-staged": "^13.1.0",
    "prettier": "^2.8.1",
    "pretty-quick": "^2.0.2",
    "sass": "~1.32.0",
    "sass-loader": "^10.1.1",
    "scss-loader": "^0.0.1",
    "ts-jest": "^26.5.0",
    "typescript": "4.3",
    "vue-jest": "^3.0.7",
    "vue-template-compiler": "^2.6.12",
    "vuetify-loader": "^1.7.0",
    "vuex-module-decorators": "^1.0.1"
  },
  "jest": {
    "testResultsProcessor": "jest-sonar-reporter",
    "moduleFileExtensions": [
      "js",
      "ts",
      "json",
      "vue"
    ],
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/src/$1"
    },
    "globals": {
      "ts-jest": {
        "tsconfig": "tsconfig.jest.json"
      }
    },
    "transform": {
      "^.+\\.tsx?$": "ts-jest",
      ".*\\.(vue)$": "vue-jest"
    },
    "testURL": "http://localhost/",
    "testRegex": "(/tests/.*|(\\.|/)(test|spec))\\.(jsx?|tsx?)$",
    "coverageDirectory": "coverage",
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/cypress/"
    ]
  },
  "jestSonar": {
    "reportPath": "reports",
    "reportFile": "test-reporter.xml",
    "indent": 4
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged"
    }
  },
  "postcss": {
    "plugins": {
      "autoprefixer": {}
    }
  },
  "lint-staged": {
    "src/**/*.{js,vue,html,css}": "prettier --write",
    "src/**/*.{js,vue}": "eslint --fix"
  },
  "volta": {
    "node": "16.20.2"
  }
}
