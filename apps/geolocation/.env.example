HOST=localhost
PORT=3009

LOG_LEVEL=DEBUG

# === Tier and storage layout ================================================
# Tier selects both the data source and the on-disk filename. The service
# memory-maps `${GEO_MMDB_DIR}/<filename>` where the filename is derived from
# this var: lite → dbip-city-lite.mmdb, full → dbip-city-full.mmdb,
# maxmind → geolite2-city.mmdb. Use `api` or `disabled` to skip the MMDB
# entirely (only the cache path / no-op are exercised).
GEO_TIER=lite

# Directory holding the MMDB. In docker-compose this is overridden to
# /data/geo (the volume mount target). Override here only for host-side dev
# runs where the MMDB lives outside the container path.
# GEO_MMDB_DIR=../geoip

# === Refresh sidecar (geolocation-refresh) ==================================
# These are read by scripts/download-geodb.sh inside the sidecar. Compose
# loads this same file for the sidecar service via `env_file:`, so adding a
# value here propagates to both the service and the sidecar without a
# `docker compose up -d --force-recreate` ambiguity.

# DB-IP subscriber API key — required when GEO_TIER=full.
# DBIP_API_KEY=

# MaxMind credentials — required when GEO_TIER=maxmind. The sidecar uses
# these to drive `geoipupdate`. The geoipupdate binary must be available
# inside the sidecar image (see docs/geodb.md > Switching to MaxMind).
# MAXMIND_ACCOUNT_ID=
# MAXMIND_LICENSE_KEY=

# === Watcher tuning =========================================================
# Set to false to disable the file watcher that reloads the MMDB after the
# refresh sidecar swaps the file. Defaults to enabled.
# GEO_WATCH_ENABLED=true

# Debounce (ms) between detecting a change and reloading. Buffers against
# partial writes from non-atomic copies. Default 5000.
# GEO_WATCH_DEBOUNCE_MS=5000
