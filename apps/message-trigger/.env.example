PORT=3006
LOG_LEVEL=DEBUG

SERVICE_ACCOUNT=

TOPIC_NAME_MESSAGE_TRIGGER=msgops.message.trigger
TOPIC_NAME_SEND_EMAIL=msgops.send.email
TOPIC_NAME_TAG_PROCESS=msgops.tag-process
TOPIC_NAME_SEND_PUSH=msgops.send.push
TOPIC_NAME_SEND_TWILIO=msgops.send.twilio
TOPIC_NAME_SEND_WHATSAPP=msgops.send.whatsapp
TOPIC_NAME_API_STEP_PROCESS=msgops-api-step-process
TOPIC_NAME_HTTP_REQUEST=msgops-http-request
TOPIC_NAME_EVENT_PROCESS=
TOPIC_FEATURE_EMAIL_PULL_SENDER=

# Cloud Tasks (GCP)
GOOGLE_TASK_PROJECT=<your-gcp-project-id>
GOOGLE_TASK_QUEUE_TIMER=message-trigger-timer
GOOGLE_TASK_QUEUE_CONDITION=message-trigger-condition
GOOGLE_TASK_LOCATION=us-east1
GOOGLE_CLIENT_EMAIL=<service-account-email@your-project.iam.gserviceaccount.com>
GOOGLE_TASK_CALLBACK_URL=https://your-message-trigger.example.com

TYPEORM_HOST=127.0.0.1
TYPEORM_PORT=5432
TYPEORM_USERNAME=postgres
TYPEORM_PASSWORD=
TYPEORM_DATABASE=msgops_prd
TYPEORM_DRIVER_EXTRA={"charset":"utf8mb4_unicode_ci"}
TYPEORM_LOGGING=false

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

EMAIL_VERIFY_URL=http://localhost:3000

CONTACT_TRANSFER_URL=https://your-domain.example.com/bms/leads

# Tracker endpoint that records pixel events. Leave empty to disable.
PIXEL_EVENT_STORE_URL=

# ClickHouse Configuration
CLICKHOUSE_HOST=
CLICKHOUSE_USERNAME=
CLICKHOUSE_PASSWORD=
CLICKHOUSE_DATABASE=BMS
