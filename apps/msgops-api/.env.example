SERVER_PORT=5001

API_DOCS=/api-docs

TYPEORM_HOST=127.0.0.1
TYPEORM_PORT=5432
TYPEORM_USERNAME=postgres
TYPEORM_PASSWORD=
TYPEORM_DATABASE=msgops
TYPEORM_DRIVER_EXTRA={"charset":"utf8mb4_unicode_ci"}
TYPEORM_LOGGING=true
TYPEORM_MIGRATIONS_RUN=true
TYPEORM_SSL=false
TYPEORM_SYNCHRONIZE=false

CLICKHOUSE_HOST=
CLICKHOUSE_USERNAME=
CLICKHOUSE_PASSWORD=
CLICKHOUSE_DATABASE=BMS

GLOCK_API_KEY=

# SendGrid
# ----------------------------------------------------------------------------
# Platform-level SendGrid settings (API key, IP pool, base URL, webhook URL)
# are configured via the BMS admin UI at /super-admin/integrations → SendGrid
# (plataforma) and stored in the system_config table.
#
# These env vars are NO LONGER the source of truth. They are only used as a
# fallback during the setup wizard health check (before the first admin UI
# configuration). Leave them unset in production.
#
# Per-account API keys (used for campaign sends) are configured by each operator
# at Settings → SendGrid and are NOT affected by this section.
SENDGRID_API_KEY=
SENDGRID_WEBHOOK_URL_BASE=

SPARKPOST_API_KEY=
LIMIT_SPARKPOST=200

CAMPAIGN_TRIGGER_ENDPOINT=http://campaign-packer:3000/create-contacts-send
CAMPAIGN_TEST_AB_ENDPOINT=http://campaign-packer:3000/create-test
CAMPAIGN_RESULT_TEST_AB_ENDPOINT=http://campaign-packer:3000/result-test
TAG_PROCESS_ENDPOINT=http://tag-process:3000/process-segment

BRIUS_HOSTURL=https://your-msgops-api.example.com

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

AMQP_URL=amqp://guest:guest@localhost:5672

# S3 / object storage
# ----------------------------------------------------------------------------
# S3 credentials are configured via the BMS admin UI at /super-admin/integrations
# → S3 and stored in the system_config table.
#
# These env vars are used as a fallback for the setup wizard health check (Step 6),
# which runs BEFORE the admin UI is accessible on a fresh install. You must set
# them for the first deployment so the wizard can verify S3 connectivity.
# After the setup wizard completes, configure S3 via the admin UI and you can
# optionally remove these vars — the runtime will read from the database instead.
S3_ENDPOINT=http://localhost:9100
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_BUCKET=bms-assets

# Auth provider selection: local | auth0 (default: local)
AUTH_PROVIDER=local

# Local provider (used when AUTH_PROVIDER=local)
# Gere um segredo novo com: openssl rand -hex 32
JWT_SECRET=replace-with-openssl-rand-hex-32
JWT_ACCESS_TTL=3600
JWT_REFRESH_TTL=2592000
# JWT_AUDIENCE é independente de IDP_AUDIENCE (Auth0). Pode ser qualquer string estável.
JWT_AUDIENCE=bms-msgops-api

# Auth0 provider (só usado quando AUTH_PROVIDER=auth0)
AUTH0_DOMAIN=<your-tenant>.us.auth0.com
AUTH0_CLIENT_ID=<your-auth0-client-id>
AUTH0_CLIENT_SECRET=<your-auth0-client-secret>
JWKS_URI=https://<your-tenant>.us.auth0.com/.well-known/jwks.json
IDP_ISSUER=https://<your-tenant>.us.auth0.com/
IDP_AUDIENCE=<your-api-audience>

BMS_ASSETS_URL=assets.example.com

CLOUDFLARE_ZONE_ID=
CLOUDFLARE_API_KEY=
CLOUDFLARE_PUSH_WORKERS_SECRET=
CLOUDFLARE_PUSH_WORKERS_URL=https://your-assets.example.com/bms/url-filters/rules

CLEAN_PUSH_DAYS=
REMOVE_PUSH_DAYS=
DEACTIVATE_CONTACTS_IN_DAYS=90

EVOLUTION_API_URL=
EVOLUTION_API_KEY=
TEMPLATE_WEBHOOK_URL=https://your-msgops-api.example.com/messages/template/webhook

# evolution or twilio
WHATSAPP_PROVIDER=evolution

# Call the email-validation service before 2FA email. Set to 'true' to enable; default 'false' validates format locally only.
# OSS default is 'false' (no paid validation). UPGRADE NOTE: deploys upgrading from a version without this flag had
# external validation always-on — set EMAIL_VALIDATION_ENABLED=true here to preserve that behavior.
# Accepted truthy values (case-insensitive): true, 1, yes. Anything else is treated as disabled.
EMAIL_VALIDATION_ENABLED=false
EMAIL_VALIDATION_URL=https://your-domain.example.com/bms/

ACCOUNTS_TO_VERIFY_CAMPAIGNS=1
CAMPAIGN_LIMIT_TO_VERIFY_ACCOUNT=
LIMIT_CONTACT_CUSTOM_FIELD_BATCH=100

SLACK_WEBHOOK_URL_RETENTION=
SLACK_WEBHOOK_URL_MSGOPS=
DISCORD_API_WEBHOOK=

CRON_SECRET=

# In-process scheduler that flushes Redis statistics into Postgres
# events_statistics on this interval (ms). Defaults to 60_000 (1 min).
# Set to 0 to disable. Uncomment to override.
# STATISTICS_AGGREGATION_INTERVAL_MS=60000

OPEN_AI_KEY=

SENTRY_DSN=

FRONTEND_URL=http://localhost:8080

TRANSACTIONAL_FROM_EMAIL=noreply@msgops.com
TRANSACTIONAL_FROM_NAME=MsgOps

BYPASS_DOMAINS=

UNLAYER_MIGRATION_ENABLED=false

# CORS allowlist: comma-separated list of origins allowed to call the API
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
CORS_CF_PAGES_PROJECT=
