SERVER_PORT=5001

API_DOCS=/api-docs

TYPEORM_HOST=127.0.0.1
TYPEORM_PORT=5432
TYPEORM_USERNAME=postgres
TYPEORM_PASSWORD=
TYPEORM_DATABASE=msgops
TYPEORM_DRIVER_EXTRA={"charset":"utf8mb4_unicode_ci"}
TYPEORM_LOGGING=true
TYPEORM_MIGRATIONS_RUN=true
TYPEORM_SSL=false
TYPEORM_SYNCHRONIZE=false

CLICKHOUSE_HOST=
CLICKHOUSE_USERNAME=
CLICKHOUSE_PASSWORD=
CLICKHOUSE_DATABASE=BMS

GLOCK_API_KEY=

# SendGrid
# ----------------------------------------------------------------------------
# The SendGrid API key is configured PER ACCOUNT in the BMS UI (Settings →
# SendGrid). There is no platform-wide fallback — every tenant pastes their
# own key. Internal transactional emails (password reset, etc.) still use the
# legacy SENDGRID_API_KEY env var below if you want, but it is NOT used for
# customer sends.
SENDGRID_API_KEY=
SENDGRID_IP_POOL=

# Public base URL the SendGrid event webhook will POST events to. The backend
# appends `&account=<id>` per tenant when registering the webhook. The path
# must match what the gateway / event-process worker expects.
#
# Local dev with ngrok:
#   1. ngrok http 5001
#   2. Copy the HTTPS forwarding URL and paste below:
#      SENDGRID_WEBHOOK_URL_BASE=https://abc123.ngrok-free.app/bms/events?platform=sendgrid
#
# Production (Brius cloud):
#   SENDGRID_WEBHOOK_URL_BASE=https://in.bri.us/bms/events/?platform=sendgrid
SENDGRID_WEBHOOK_URL_BASE=https://your-domain.example.com/bms/events/?platform=sendgrid

SPARKPOST_API_KEY=
LIMIT_SPARKPOST=200

# Scheduler queue names (BullMQ on Redis). Variables keep the legacy
# GOOGLE_TASK_* prefix because DB columns and call sites still pass them as
# routing metadata; the actual queue is one of five dedicated BullMQ queues
# under the hood (see apps/msgops-api/src/providers/queue/queue.constants.ts).
CAMPAIGN_TRIGGER_ENDPOINT=https://your-campaign-trigger.example.com/
GOOGLE_TASK_QUEUE=message-trigger-timer
GOOGLE_TASK_QUEUE_TEST_AB=msgops-campaign-testab
CAMPAIGN_TEST_AB_ENDPOINT=https://your-campaign-packer.example.com/create-test
CAMPAIGN_RESULT_TEST_AB_ENDPOINT=https://your-campaign-packer.example.com/result-test

GOOGLE_TASK_SEGMENT=segment-process
TAG_PROCESS_ENDPOINT=https://your-tag-process.example.com/process-segment

GOOGLE_TASK_BMS_USAGE=msgops-bms-usage
GOOGLE_TASK_WHATSAPP_MESSAGE=msgops-whatsapp-message

BRIUS_HOSTURL=https://your-msgops-api.example.com

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

AMQP_URL=amqp://guest:guest@localhost:5672

S3_ENDPOINT=http://localhost:9100
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_BUCKET=bms-assets
# AWS S3 buckets created after April 2023 default to BucketOwnerEnforced
# (object ACLs disabled). MinIO and pre-2023 buckets accept the public-read
# ACL the storage provider sets when uploading public assets. For new AWS
# buckets, attach a public bucket policy and grant read on the asset prefix,
# then set S3_USE_OBJECT_ACLS=false to disable per-object ACLs.
S3_USE_OBJECT_ACLS=true

# Auth provider selection: local | auth0 (default: local)
AUTH_PROVIDER=local

# Local provider (used when AUTH_PROVIDER=local)
# Gere um segredo novo com: openssl rand -hex 32
JWT_SECRET=replace-with-openssl-rand-hex-32
JWT_ACCESS_TTL=3600
JWT_REFRESH_TTL=2592000
# JWT_AUDIENCE é independente de IDP_AUDIENCE (Auth0). Pode ser qualquer string estável.
JWT_AUDIENCE=bms-msgops-api
# Bootstrap admin (opcional): se presente e a tabela users estiver vazia no primeiro boot,
# cria um admin automaticamente (útil pra deploy automatizado via IaC).
# Se ausentes, o setup wizard cria o primeiro admin na UI.
# BOOTSTRAP_ADMIN_EMAIL=admin@example.com
# BOOTSTRAP_ADMIN_PASSWORD=ChangeMeOnFirstBoot!

# Auth0 provider (só usado quando AUTH_PROVIDER=auth0)
AUTH0_DOMAIN=<your-tenant>.us.auth0.com
AUTH0_CLIENT_ID=<your-auth0-client-id>
AUTH0_CLIENT_SECRET=<your-auth0-client-secret>
JWKS_URI=https://<your-tenant>.us.auth0.com/.well-known/jwks.json
IDP_ISSUER=https://<your-tenant>.us.auth0.com/
IDP_AUDIENCE=<your-api-audience>

BMS_ASSETS_URL=assets.example.com

CLOUDFLARE_ZONE_ID=
CLOUDFLARE_API_KEY=
CLOUDFLARE_PUSH_WORKERS_SECRET=
CLOUDFLARE_PUSH_WORKERS_URL=https://your-assets.example.com/bms/url-filters/rules

CLEAN_PUSH_DAYS=
REMOVE_PUSH_DAYS=
DEACTIVATE_CONTACTS_IN_DAYS=90

EVOLUTION_API_URL=
EVOLUTION_API_KEY=
TEMPLATE_WEBHOOK_URL=https://your-msgops-api.example.com/messages/template/webhook

# evolution or twilio
WHATSAPP_PROVIDER=evolution

EMAIL_VALIDATION_URL=https://your-domain.example.com/bms/

ACCOUNTS_TO_VERIFY_CAMPAIGNS=1
CAMPAIGN_LIMIT_TO_VERIFY_ACCOUNT=
LIMIT_CONTACT_CUSTOM_FIELD_BATCH=100

SLACK_WEBHOOK_URL_RETENTION=
SLACK_WEBHOOK_URL_MSGOPS=
DISCORD_API_WEBHOOK=

CRON_SECRET=

OPEN_AI_KEY=

SENTRY_DSN=

FRONTEND_URL=http://localhost:8080

TRANSACTIONAL_FROM_EMAIL=noreply@msgops.com
TRANSACTIONAL_FROM_NAME=MsgOps

BYPASS_DOMAINS=

UNLAYER_MIGRATION_ENABLED=false

# CORS allowlist: comma-separated list of origins allowed to call the API
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
CORS_CF_PAGES_PROJECT=
