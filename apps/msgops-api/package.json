{
  "name": "msgops-api",
  "version": "0.1.1",
  "description": "An API for messaging operations (ETUS & DTI).",
  "license": "MIT",
  "author": "lucas.haddad <lucas.haddad@dtidigital.com.br>",
  "scripts": {
    "prebuild": "rimraf dist",
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "sonar": "ts-node-dev sonar-project.ts",
    "lint": "eslint \"{src,test}/**/*.ts\" --fix",
    "type-check": "tsc --noEmit",
    "pre-commit": "lint-staged",
    "test": "jest --config jest.config.ts",
    "test:watch": "jest --watch --config jest.config.ts",
    "test:e2e": "NODE_ENV=test jest --config ./tests/e2e/jest-e2e.json",
    "typeorm": "node ./node_modules/typeorm/cli.js",
    "typeorm:migration:generate": "pnpm build && pnpm typeorm migration:generate -d dist/database/data-source.js",
    "typeorm:migration:run": "pnpm build && pnpm typeorm migration:run -d dist/database/data-source.js",
    "typeorm:migration:revert": "pnpm build && pnpm typeorm migration:revert -d dist/database/data-source.js",
    "test:cov": "jest --coverage --config jest.config.ts"
  },
  "dependencies": {
    "@clickhouse/client": "^1.15.0",
    "@google-cloud/pubsub": "^5.3.0",
    "@google-cloud/storage": "^7.0.0",
    "@google-cloud/tasks": "^6.2.1",
    "@jest/types": "^30.3.0",
    "@nestjs/axios": "^4.0.0",
    "@nestjs/common": "^11.1.16",
    "@nestjs/core": "^11.1.16",
    "@nestjs/passport": "^11.0.0",
    "@nestjs/platform-express": "^11.1.16",
    "@nestjs/swagger": "^11.2.0",
    "@nestjs/typeorm": "^11.0.0",
    "@sendgrid/mail": "^8.1.6",
    "@sentry/node": "^10.43.0",
    "@types/auth0": "^3.3.11",
    "ajv": "^8.13.0",
    "ajv-errors": "^3.0.0",
    "auth0": "^5.4.0",
    "axios": "^1.0.0",
    "body-parser": "^2.2.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "cookie-parser": "^1.4.5",
    "cors": "^2.8.5",
    "dateformat": "^5.0.3",
    "dayjs": "^1.10.7",
    "dayjs-plugin-utc": "^0.1.2",
    "dotenv": "^17.3.1",
    "fast-csv": "^5.0.2",
    "ioredis": "^5.10.0",
    "joi": "^18.0.2",
    "jsdom": "25.0.1",
    "json2csv": "^6.0.0-alpha.2",
    "jsonwebtoken": "^9.0.3",
    "jwks-rsa": "^4.0.1",
    "libphonenumber-js": "^1.12.8",
    "nestjs-cls": "^6.2.0",
    "nestjs-joi": "^1.12.0",
    "openai": "^6.27.0",
    "passport": "^0.7.0",
    "passport-headerapikey": "^1.2.2",
    "passport-jwt": "^4.0.0",
    "pg": "^8.7.3",
    "pg-query-stream": "^4.10.3",
    "qs": "^6.15.1",
    "reflect-metadata": "^0.2.2",
    "request-ip": "^3.3.0",
    "rimraf": "^6.1.3",
    "rxjs": "^7.8.0",
    "sharp": "^0.34.5",
    "slugify": "^1.4.6",
    "sparkpost": "^2.1.4",
    "swagger-ui-express": "^5.0.0",
    "typeorm": "^0.3.20"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.4.3",
    "@commitlint/config-conventional": "^20.4.3",
    "@eslint/js": "^10.0.1",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.1.16",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^25.4.0",
    "@types/passport-local": "^1.0.33",
    "@types/supertest": "^7.2.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^10.0.3",
    "eslint-config-prettier": "^10.0.0",
    "eslint-plugin-prettier": "^5.0.0",
    "jest": "^30.3.0",
    "jest-cli": "^30.3.0",
    "jest-sonar": "^0.2.16",
    "lint-staged": "^16.3.3",
    "nock": "^14.0.11",
    "prettier": "^3.0.0",
    "sonarqube-scanner": "^4.3.4",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.6",
    "ts-loader": "^9.5.4",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.0.0"
  }
}
