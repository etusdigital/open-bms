{
  "compilerOptions": {
    "target": "ESNext",
    "useDefineForClassFields": true,
    "module": "ESNext",
    "moduleResolution": "Node",
    "strict": true,
    "jsx": "preserve",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "lib": ["ESNext", "DOM"],
    "skipLibCheck": true,
    "noEmit": true,
    "allowJs": true,
    "types": ["vitest/globals", "vite/client"]
  },
  "exclude": [
    "node_modules",
    ".storybook/**/*.js",
    ".storybook/**/*.ts",
    "**/*.stories.ts",
    "stories/**/*.js",
    "stories/**/*.ts"
  ],
  "include": ["src/**/*.js", "src/**/*.ts", "src/**/*.d.ts", "src/**/*.vue", "src/entities/Account/Account.types.ts"],
  "references": [{ "path": "./tsconfig.node.json" }]
}
