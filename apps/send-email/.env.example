PORT=3005

SENDGRID_API_KEY=
SENDGRID_IP_POOL=

# JSON map of SendGrid API keys by name. Required for account-specific key routing.
# Example: {"key-name":"SG.xxx","other-key":"SG.xxx"}
# See src/mail/sendgrid-key-registry.ts for required key names.
SENDGRID_KEYS_MAP=

SPARKPOST_API_KEY=

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

AMQP_URL=amqp://guest:guest@localhost:5672
INTERNAL_AUTH_TOKEN=dev-send-email-token-change-me-please
BRIDGE_ENDPOINT=http://localhost:3005

# S3-compatible object storage (MinIO/S3/R2/etc.)
# Defaults below match the MinIO service in docker-compose.yml.
# Bucket is not configured here — send-email reads it from each message payload.
S3_ENDPOINT=http://localhost:9100
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin

SANDBOX_MODE=false

LIMIT_CONTACT_BATCH=
MESSAGES_TO_ADD_FWD=
FEATURE_SPLIT_TERM=

LOG_LEVEL=DEBUG
