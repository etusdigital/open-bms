PORT=3005

# SendGrid platform credentials (API key, IP pool, base URL) are configured via
# the BMS admin UI at /super-admin/integrations and loaded automatically from
# /data/config/sendgrid.env on startup. Do NOT set them here.

# JSON map of SendGrid API keys by name. Required for account-specific key routing.
# Example: {"key-name":"SG.xxx","other-key":"SG.xxx"}
# See src/mail/sendgrid-key-registry.ts for required key names.
SENDGRID_KEYS_MAP=

SPARKPOST_API_KEY=

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

AMQP_URL=amqp://guest:guest@localhost:5672
INTERNAL_AUTH_TOKEN=dev-send-email-token-change-me-please
BRIDGE_ENDPOINT=http://localhost:3005

# S3 credentials are configured via the BMS admin UI at /super-admin/integrations
# and loaded automatically from /data/config/s3.env on startup. Do NOT set them here.

SANDBOX_MODE=false

LIMIT_CONTACT_BATCH=
MESSAGES_TO_ADD_FWD=
FEATURE_SPLIT_TERM=

LOG_LEVEL=DEBUG
