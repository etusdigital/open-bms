PORT=3000
LOG_LEVEL=DEBUG

# FCM credentials (Firebase service account JSON) are configured via the BMS admin
# UI at /super-admin/integrations and loaded automatically from /data/config/fcm.env
# on startup. Do NOT set FIREBASE_SERVICE_ACCOUNT here.

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

AMQP_URL=amqp://guest:guest@localhost:5672
INTERNAL_AUTH_TOKEN=dev-send-push-token-change-me-please-x
BRIDGE_ENDPOINT=http://localhost:3000
