PORT=3008
LOG_LEVEL=INFO

SERVICE_ACCOUNT=

TYPEORM_HOST=127.0.0.1
TYPEORM_PORT=5432
TYPEORM_USERNAME=postgres
TYPEORM_PASSWORD=
TYPEORM_DATABASE=msgops
TYPEORM_DRIVER_EXTRA={"charset":"utf8mb4_unicode_ci"}
TYPEORM_LOGGING=false

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

CLICKHOUSE_HOST=
CLICKHOUSE_DATABASE=BMS
CLICKHOUSE_USERNAME=
CLICKHOUSE_PASSWORD=

# Cloud Tasks (GCP)
GOOGLE_TASKS_PROJECT_ID=<your-gcp-project-id>
GOOGLE_TASKS_LOCATION=us-east1
GOOGLE_TASK_SEGMENT=segment-process
GOOGLE_CLIENT_EMAIL=<service-account-email@your-project.iam.gserviceaccount.com>
TAG_PROCESS_ENDPOINT=https://your-tag-process.example.com/process-segment

TOPIC_NAME_MESSAGE_TRIGGER=msgops.message.trigger
TOPIC_NAME_CREATE_CONTACTS_BATCH=msgops.tag.process.create.contacts
TOPIC_NAME_CLICK_HOUSE=
TOPIC_NAME_SEGMENT_TO_CLICK_HOUSE=

FEATURE_SPLIT_TERM=

# Tracker endpoint that records pixel events. Leave empty to disable.
PIXEL_EVENT_STORE_URL=
