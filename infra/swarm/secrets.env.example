# =============================================================================
#  Template de envs do BMS Open Source — Docker Swarm deploy
# =============================================================================
#
#  Guia completo: docs/STAGING-DEPLOY.md
#
#  NÃO commite o arquivo real com valores reais. Este `.example` lista os
#  nomes com instruções de como gerar cada valor.
#
#  Você pode:
#  - Copiar este arquivo pra um `.env` local e preencher.
#  - OU colar como Environment variables no Portainer Stack (aba abaixo do YAML).
#
# -----------------------------------------------------------------------------
#  GERAÇÃO RÁPIDA (cole no terminal — escreve um .env preenchido)
# -----------------------------------------------------------------------------
#
#  {
#    echo "FRONTEND_HOST=bms-app.exemplo.ai"
#    echo "CH_UI_HOST=ch-ui-bms.exemplo.ai"
#    echo "FRONTEND_URL=https://bms-app.exemplo.ai"
#    echo "CORS_ORIGINS=https://bms-app.exemplo.ai"
#    echo "IMAGE_REGISTRY=evoapicloud"
#    echo "IMAGE_TAG=latest"
#    echo "TRAEFIK_NETWORK_NAME=bmsNet"
#    echo "LETSENCRYPT_EMAIL=admin@exemplo.com"
#    echo "POSTGRES_PASSWORD=$(openssl rand -base64 24)"
#    echo "RABBITMQ_USER=bms"
#    echo "RABBITMQ_PASSWORD=$(openssl rand -base64 24)"
#    echo "INTERNAL_AUTH_TOKEN=$(openssl rand -base64 32)"
#    echo "MINIO_ROOT_USER=bmsadmin"
#    echo "MINIO_ROOT_PASSWORD=$(openssl rand -base64 24)"
#    echo "JWT_SECRET=$(openssl rand -base64 48)"
#    echo "CRON_SECRET=$(openssl rand -base64 32)"
#    echo "CLICKHOUSE_PASSWORD=$(openssl rand -base64 24)"
#    echo "CH_UI_SECRET_KEY=$(openssl rand -base64 32)"
#    echo "ENTERPRISE_IMPORT_ENCRYPTION_KEY=$(openssl rand -base64 32)"
#    echo "BOOTSTRAP_ADMIN_EMAIL=admin@exemplo.com"
#    echo "BOOTSTRAP_ADMIN_PASSWORD=$(openssl rand -base64 18)"
#  } > .env && chmod 600 .env
#
# =============================================================================


# -----------------------------------------------------------------------------
# HOSTS / IMAGENS — preencher conforme seu ambiente
# -----------------------------------------------------------------------------

# Hostname público do app (frontend + API + webhooks). Precisa de DNS apontando
# pro IP do manager + cert Let's Encrypt gerado pelo Traefik.
FRONTEND_HOST=

# Hostname público do console ClickHouse (ch-ui). Mesmo cuidado.
CH_UI_HOST=

# URL completa com https:// — usada pelo backend pra CORS, links em emails etc.
# Geralmente: https://${FRONTEND_HOST}
FRONTEND_URL=

# Origins permitidos no CORS. Lista separada por vírgula se múltiplos.
# Geralmente: https://${FRONTEND_HOST}
CORS_ORIGINS=

# Org do Docker Hub que publica as imagens BMS.
IMAGE_REGISTRY=evoapicloud

# Tag das imagens. Cada execução do infra/swarm/build-and-push.sh imprime
# a tag a usar aqui (ex: bms-staging-a1b2c3d). Use `latest` em dev.
IMAGE_TAG=latest

# Nome da rede overlay externa onde Traefik vive. Tem que existir antes
# do deploy (docker network create --driver overlay --attachable bmsNet).
TRAEFIK_NETWORK_NAME=bmsNet

# Email pro Let's Encrypt (Traefik usa pra alertas de cert expirando).
LETSENCRYPT_EMAIL=


# -----------------------------------------------------------------------------
# SENHAS / SEGREDOS — gerar com openssl, NUNCA commitar valores reais
# -----------------------------------------------------------------------------

# Postgres principal — `openssl rand -base64 24`
POSTGRES_PASSWORD=

# RabbitMQ — `openssl rand -base64 24`
RABBITMQ_USER=bms
RABBITMQ_PASSWORD=

# Token interno usado entre os microservices BMS — `openssl rand -base64 32`
INTERNAL_AUTH_TOKEN=

# MinIO (S3-compatible storage) — `openssl rand -base64 24`
MINIO_ROOT_USER=bmsadmin
MINIO_ROOT_PASSWORD=

# JWT do msgops-api (assinatura dos access tokens) — `openssl rand -base64 48`
JWT_SECRET=

# Cron secret (autoriza endpoints de schedule) — `openssl rand -base64 32`
CRON_SECRET=

# ClickHouse (analytics) — `openssl rand -base64 24`
# Você usa essa senha uma vez ao abrir a conexão "BMS" dentro do ch-ui.
CLICKHOUSE_PASSWORD=

# ch-ui (console web do ClickHouse) — `openssl rand -base64 32`
# Assina os cookies de sessão. ch-ui tem login próprio (não é o do BMS).
CH_UI_SECRET_KEY=

# ENTERPRISE IMPORT — AES-256 (32 bytes base64) — `openssl rand -base64 32`
# Cifra a API key do Enterprise no banco quando você faz import.
#
# ⚠️  PERDER essa chave = dados cifrados ficam ilegíveis. Guarde em cofre
#     (1Password, Bitwarden) ao lado do POSTGRES_PASSWORD.
#
# Sem essa env, POST /accounts/import dá 500 com erro
# "ENTERPRISE_IMPORT_ENCRYPTION_KEY not set" (api-key-encryption.util.ts).
ENTERPRISE_IMPORT_ENCRYPTION_KEY=


# -----------------------------------------------------------------------------
# BOOTSTRAP ADMIN (criado no primeiro boot, se a tabela users estiver vazia)
# -----------------------------------------------------------------------------

# Email do super-admin inicial. Você usa pra logar no /setup pela primeira vez.
BOOTSTRAP_ADMIN_EMAIL=

# Senha forte — `openssl rand -base64 18`
BOOTSTRAP_ADMIN_PASSWORD=
