# Template para /opt/bms-staging/.env no manager.
#
# NÃO commite o arquivo real com valores reais. Este `.example` mostra só
# os nomes; gere os valores no manager via openssl rand:
#
#   {
#     echo "POSTGRES_PASSWORD=$(openssl rand -hex 24)"
#     echo "RABBITMQ_USER=bms"
#     echo "RABBITMQ_PASSWORD=$(openssl rand -hex 24)"
#     echo "INTERNAL_AUTH_TOKEN=$(openssl rand -hex 32)"
#     echo "MINIO_ROOT_USER=bmsadmin"
#     echo "MINIO_ROOT_PASSWORD=$(openssl rand -hex 24)"
#     echo "JWT_SECRET=$(openssl rand -hex 32)"
#     echo "CRON_SECRET=$(openssl rand -hex 32)"
#     echo "BOOTSTRAP_ADMIN_EMAIL=<email-real-do-admin>"
#     echo "BOOTSTRAP_ADMIN_PASSWORD=$(openssl rand -base64 18)"
#     echo "IMAGE_TAG=<gerado-pelo-build-and-push.sh>"
#   } > /opt/bms-staging/.env
#   chmod 600 /opt/bms-staging/.env
#   chown root:root /opt/bms-staging/.env

POSTGRES_PASSWORD=
RABBITMQ_USER=bms
RABBITMQ_PASSWORD=
INTERNAL_AUTH_TOKEN=
MINIO_ROOT_USER=bmsadmin
MINIO_ROOT_PASSWORD=
JWT_SECRET=
CRON_SECRET=
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

# Tag das imagens no Docker Hub. Cada execução de
# infra/swarm/build-and-push.sh imprime a tag a usar aqui.
# Ex: bms-staging-a1b2c3d
IMAGE_TAG=
