# Copy to `.env.stress` and fill in. `.env.stress` is gitignored.
#
# Base URL of msgops-api exposed by docker-compose. Point directly to the
# container's published port — NOT through nginx/cloudflare/proxies, since
# those alter timeout/error semantics.
STRESS_API_URL=http://localhost:5001

# Login credentials for a user that has permission `audience:contacts_import`
# on the target account. Easiest path: use the BOOTSTRAP_ADMIN created by
# apps/msgops-api on first boot (BOOTSTRAP_ADMIN_EMAIL / _PASSWORD).
STRESS_EMAIL=
STRESS_PASSWORD=

# Numeric `id` of the account to import into (PrincipalContextGuard sends
# this through the `Account-Id` header). Query the `accounts` table in
# the compose Postgres if you don't know it:
#   docker exec -it postgres psql -U <user> -d <db> -c 'select id, name from accounts;'
STRESS_ACCOUNT_ID=
